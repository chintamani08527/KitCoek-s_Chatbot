# Google Gemini API Key Pool Model (Automatic Round-Robin Load Balancing & Failover)
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_API_KEY_4=your_gemini_api_key_4_here

# Default Fallback Key
GEMINI_API_KEY=your_gemini_api_key_1_here

# Gemini Models
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Database Configuration (PostgreSQL on Neon/Supabase or SQLite fallback)
# For Vercel production: postgresql://username:password@ep-something.neon.tech/kitcoek_db?sslmode=require
# If left as default on Vercel, it automatically falls back to /tmp/kitcoek.db
DATABASE_URL=sqlite:///./backend/data/kitcoek.db

# RAG Persistent Index Directory
CHROMA_PERSIST_DIRECTORY=./backend/data/chroma_db

# RAG Retrieval Settings
TOP_K_RESULTS=4
SIMILARITY_THRESHOLD=0.35
