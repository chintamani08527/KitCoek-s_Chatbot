# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Models
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Database Configuration (PostgreSQL or SQLite)
# PostgreSQL format: postgresql://postgres:password@localhost:5432/kitcoek_db
# SQLite fallback format: sqlite:///./backend/data/kitcoek.db
DATABASE_URL=sqlite:///./backend/data/kitcoek.db

# ChromaDB Persistent Storage
CHROMA_PERSIST_DIRECTORY=./backend/data/chroma_db

# RAG Settings
TOP_K_RESULTS=4
SIMILARITY_THRESHOLD=0.35
